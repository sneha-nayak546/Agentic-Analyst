invalid type: string "TABLE NAME: withdrawal_request\n\nSCHEMA DDL:\nCREATE TABLE withdrawal_request (\n  id BIGINT NOT NULL,\n  user_id INTEGER NOT NULL,\n  amount INTEGER NOT NULL,\n  bank_transaction_id VARCHAR(255) COLLATE \"utf8mb4_unicode_ci\",\n  delivery_proof VARCHAR(255) COLLATE \"utf8mb4_unicode_ci\",\n  status TINYINT NOT NULL COMMENT '0=pending , 1=approved , 2=Reject',\nÿÿÿÿÿÿÿÿÿÿÿÿÿ