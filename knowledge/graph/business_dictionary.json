        },
        "scanned boxes wholesaler": {
            "target_table": "sku_inventories",
            "condition": "wholesaler_scanned_at IS NOT NULL AND status_wholeseller_id IS NOT NULL",
            "date_column": "wholesaler_scanned_at",
