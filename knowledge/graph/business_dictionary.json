        "monthly earnings": {
            "table": "wallet_transaction",
            "column": "transaction_type",
            "condition": "wallet_transaction.transaction_type IN ('cash_point', 'referral_earning', 'topup', 'coupon_redeem') AND wallet_transaction.created_at >= DATE_FORMAT(NOW(), '%Y-%m-01')",
            "description": "Earnings breakdown across cash_point, referral_earning, topup, coupon_redeem for current month",
            "select_expressions": [
                "SUM(CASE WHEN wallet_transaction.transaction_type = 'cash_point' THEN wallet_transaction.amount ELSE 0 END) AS cash_point_earning",
                "SUM(CASE WHEN wallet_transaction.transaction_type = 'referral_earning' THEN wallet_transaction.amount ELSE 0 END) AS referral_earning",
                "SUM(CASE WHEN wallet_transaction.transaction_type = 'topup' THEN wallet_transaction.amount ELSE 0 END) AS topup_earning",
                "SUM(CASE WHEN wallet_transaction.transaction_type = 'coupon_redeem' THEN wallet_transaction.amount ELSE 0 END) AS coupon_redeem_earning",
                "SUM(wallet_transaction.amount) AS total_monthly_earning"
            ]
        },
        "retailer earnings": {
            "table": "wallet_transaction",
            "column": "transaction_type",
            "condition": "users.user_role = 2 AND wallet_transaction.transaction_type IN ('cash_point', 'referral_earning', 'topup', 'coupon_redeem') AND wallet_transaction.created_at >= DATE_FORMAT(NOW(), '%Y-%m-01')",
            "description": "Retailer earnings breakdown across cash_point, referral_earning, topup, coupon_redeem for current month",
            "select_expressions": [
                "SUM(CASE WHEN wallet_transaction.transaction_type = 'cash_point' THEN wallet_transaction.amount ELSE 0 END) AS cash_point_earning",
                "SUM(CASE WHEN wallet_transaction.transaction_type = 'referral_earning' THEN wallet_transaction.amount ELSE 0 END) AS referral_earning",
                "SUM(CASE WHEN wallet_transaction.transaction_type = 'topup' THEN wallet_transaction.amount ELSE 0 END) AS topup_earning",
                "SUM(CASE WHEN wallet_transaction.transaction_type = 'coupon_redeem' THEN wallet_transaction.amount ELSE 0 END) AS coupon_redeem_earning",
                "SUM(wallet_transaction.amount) AS total_monthly_earning"
            ]
        },
        "redemption": {
            "target_table": "wallet_transaction",
            "column": "reference_type",
            "value": "withdrawal",
            "description": "Redemptions or redeemed amounts map strictly to wallet_transaction.reference_type = 'withdrawal'."
        },
        "redeem": {
            "target_table": "wallet_transaction",
            "column": "reference_type",
            "value": "withdrawal",
            "description": "Redemptions or redeemed amounts map strictly to wallet_transaction.reference_type = 'withdrawal'."
        },
        "earnings": {
            "target_table": "wallet_transaction",
            "column": "reference_type",
            "values": [
                "cash_point",
                "topup",
                "coupon_redeem"
            ],
            "description": "Earnings map strictly to wallet_transaction.reference_type IN ('cash_point', 'topup', 'coupon_redeem')."
        },
        "earned": {
            "target_table": "wallet_transaction",
            "column": "reference_type",
            "values": [
                "cash_point",
                "topup",
                "coupon_redeem"
            ],
            "description": "Earnings map strictly to wallet_transaction.reference_type IN ('cash_point', 'topup', 'coupon_redeem')."
        },
        "balance": {
            "target_table": "wallet_transaction",
            "calculation_rule": "DYNAMIC_LEDGER_SUM",
            "sql_pattern": "SUM(wt.amount)",
            "description": "Always calculate wallet balance dynamically by joining users and wallet_transaction on users.id = wallet_transaction.user_id and summing wt.amount grouped by user."
        },
        "wallet balance": {
            "target_table": "wallet_transaction",
            "calculation_rule": "DYNAMIC_LEDGER_SUM",
            "sql_pattern": "SUM(wt.amount)",
            "description": "Always calculate wallet balance dynamically by joining users and wallet_transaction on users.id = wallet_transaction.user_id and summing wt.amount grouped by user."
        },
        "sku_scanned_boxes": {
            "target_table": "sku_qr_points_map",
            "calculation_rule": "COUNT_OR_SUM_BOXES",
            "wholesaler_join": "status_wholesaler_id = users.id AND wholesaler_scanned_at IS NOT NULL",
            "retailer_join": "status_retailer_id = users.id AND retailer_scanned_at IS NOT NULL",
            "description": "Calculates scanned boxes using `sku_code` join, mapping `uom` and `box_calculation_uom` across wholesaler and retailer scan timestamps."
        },
        "scanned_boxes_retailer": {
            "target_table": "sku_inventories",
            "condition": "retailer_scanned_at IS NOT NULL AND status_retailer_id IS NOT NULL",
            "date_column": "retailer_scanned_at",
            "description": "Retailer box scans joining sku_inventories and sku_qr_points_map on sku_code."
        },
        "scanned boxes retailer": {
            "target_table": "sku_inventories",
            "condition": "retailer_scanned_at IS NOT NULL AND status_retailer_id IS NOT NULL",
            "date_column": "retailer_scanned_at",
