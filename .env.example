# Environment Variable Template for AI Analytics Platform

# Database Connection (Plain text fallback if ENCRYPTED_DB_CONFIG is not used)
DB_HOST=localhost
DB_PORT=3306
DB_NAME=jghMasterDB
DB_USER=root
DB_PASSWORD=your_secure_password_here

# AES-256 Fernet Encrypted Database Configuration (Optional)
# If set, MASTER_SECRET_KEY must also be provided in environment or .master.key file
# ENCRYPTED_DB_CONFIG=gAAAAAB...
# MASTER_SECRET_KEY=your_fernet_master_key_here

# Server Configuration
PORT=8000

# Centralized Ollama Configuration (Local Inference Fallback)
OLLAMA_HOST="http://localhost:11434"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5-coder:7b"
OLLAMA_TIMEOUT=300
OLLAMA_KEEP_ALIVE="30m"
OLLAMA_NUM_CTX=2048
OLLAMA_NUM_THREAD=8

# Model Tier 1: Google Gemini (Primary Cloud Provider)
GEMINI_API_KEY="your_gemini_api_key_here"
GEMINI_MODEL="gemini-2.5-flash"

# Model Tier 2: Groq Cloud LPUs (Secondary Fast Cloud Fallback)
GROQ_API_KEY="your_groq_api_key_here"
GROQ_MODEL="qwen/qwen3.8-27b"

# Primary Provider Selection ('groq' or 'ollama')
LLM_PROVIDER="groq"

# Per-Stage Model Routing (Section 14)
LLM_INTENT_PROVIDER="groq"
LLM_INTENT_MODEL="qwen/qwen3.8-27b"

LLM_SQL_PROVIDER="ollama"
LLM_SQL_MODEL="qwen2.5-coder:7b"

LLM_SQL_VERIFIER_PROVIDER="groq"
LLM_SQL_VERIFIER_MODEL="qwen/qwen3.8-27b"

LLM_ANSWER_PROVIDER="groq"
LLM_ANSWER_MODEL="qwen/qwen3.8-27b"
